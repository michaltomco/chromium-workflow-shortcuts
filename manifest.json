{
  "manifest_version": 3,
  "name": "Chromium Workflow Shortcuts",
  "version": "2.1.1",
  "description": "Keyboard controls for tabs, groups, unloading, fullscreen, browser navigation, and video Picture-in-Picture.",
  "background": {
    "service_worker": "service-worker.js"
  },
  "commands": {
    "unload-collapse-next-group": {
      "description": "Unload and collapse group, then switch to next"
    },
    "unload-current-tab": {
      "description": "Unload current tab and switch to another tab"
    },
    "cycle-group-next": {
      "suggested_key": {
        "default": "Alt+J"
      },
      "description": "Next tab in current group"
    },
    "cycle-group-previous": {
      "description": "Previous tab in current group",
      "suggested_key": {
        "default": "Alt+K"
      }
    },
    "create-group-tab": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "New tab in current group"
    },
    "previous-tab-section": {
      "description": "Previous group or ungrouped tabs"
    },
    "next-tab-section": {
      "description": "Next group or ungrouped tabs"
    },
    "create-ungrouped-tab": {
      "description": "New ungrouped tab"
    },
    "toggle-group-mute": {
      "description": "Group 1: toggle"
    },
    "toggle-group-collapse": {
      "description": "Collapse or expand current tab group"
    },
    "expand-all-groups": {
      "description": "Expand all tab groups in current window"
    },
    "toggle-fullscreen": {
      "description": "Toggle fullscreen"
    },
    "move-tab-next": {
      "description": "Move tab down"
    },
    "move-tab-previous": {
      "description": "Move tab up"
    },
    "close-current-tab": {
      "description": "Close current tab"
    },
    "open-history": {
      "description": "Open history"
    },
    "open-downloads": {
      "description": "Open downloads"
    },
    "open-private-window": {
      "description": "Open private window"
    },
    "separate-split-view": {
      "description": "Separate views",
      "suggested_key": {
        "default": "Alt+Shift+O"
      }
    },
    "toggle-preset-2": {
      "description": "Group 2: toggle"
    },
    "toggle-preset-3": {
      "description": "Group 3: toggle"
    },
    "toggle-preset-4": {
      "description": "Group 4: toggle"
    },
    "toggle-preset-5": {
      "description": "Group 5: toggle"
    },
    "toggle-preset-6": {
      "description": "Group 6: toggle"
    },
    "toggle-preset-7": {
      "description": "Group 7: toggle"
    },
    "toggle-preset-8": {
      "description": "Group 8: toggle"
    },
    "toggle-preset-9": {
      "description": "Group 9: toggle"
    },
    "toggle-preset-10": {
      "description": "Group 10: toggle"
    },
    "video-fullscreen": {
      "description": "Video fullscreen"
    },
    "video-pip": {
      "description": "Picture-in-Picture"
    },
    "vimium-search": {
      "description": "Search in a new tab (Vimium C)"
    },
    "prepare-split-search": {
      "description": "Prepare Vimium split search (Hyprland Alt+O)"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "tabGroups",
    "storage",
    "activeTab",
    "scripting"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Shortcut settings",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "optional_permissions": [
    "tabs"
  ]
}

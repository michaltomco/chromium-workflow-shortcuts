{
  "manifest_version": 3,
  "name": "Chromium Workflow Shortcuts",
  "version": "1.26.0",
  "description": "Keyboard controls for tabs, groups, unloading, fullscreen, browser navigation, and video Picture-in-Picture.",
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shortcut-config.js",
        "keyboard.js"
      ],
      "css": [
        "video-fullscreen.css"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "commands": {
    "unload-collapse-next-group": {
      "description": "Unload and collapse group, then switch to next"
    },
    "unload-current-tab": {
      "description": "Unload current tab and switch to another tab"
    },
    "cycle-group-next": {
      "suggested_key": {
        "default": "Alt+J"
      },
      "description": "Next tab in current group"
    },
    "cycle-group-previous": {
      "description": "Previous tab in current group",
      "suggested_key": {
        "default": "Alt+K"
      }
    },
    "create-group-tab": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "New tab in current group"
    },
    "previous-tab-section": {
      "description": "Previous group or ungrouped tabs"
    },
    "next-tab-section": {
      "description": "Next group or ungrouped tabs"
    },
    "create-ungrouped-tab": {
      "description": "New ungrouped tab"
    },
    "toggle-group-mute": {
      "description": "Toggle chat group"
    },
    "toggle-group-collapse": {
      "description": "Collapse or expand current tab group"
    },
    "expand-all-groups": {
      "description": "Expand all tab groups in current window"
    },
    "mute-collapse-next-group": {
      "description": "Mute and collapse chat group"
    },
    "toggle-fullscreen": {
      "description": "Toggle fullscreen"
    },
    "move-tab-next": {
      "description": "Move tab down"
    },
    "move-tab-previous": {
      "description": "Move tab up"
    },
    "close-current-tab": {
      "description": "Close current tab"
    },
    "open-history": {
      "description": "Open history"
    },
    "open-downloads": {
      "description": "Open downloads"
    },
    "open-private-window": {
      "description": "Open private window"
    },
    "separate-split-view": {
      "description": "Separate views",
      "suggested_key": {
        "default": "Alt+Shift+O"
      }
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "tabGroups",
    "storage"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Shortcut settings",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": [
    "https://*.messenger.com/*",
    "https://*.web.whatsapp.com/*",
    "https://*.discord.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
